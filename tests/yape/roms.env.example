# Copy to roms.env and edit paths.
#
# YaPe is on Windows (D:). The matrix stages all ROMs/disks to
# STAGE_DIR=/mnt/d/tmp/parobek which YaPe sees as D:\tmp\parobek\.

YAPE_EXE=/mnt/d/tmp/YaPe-Plus4/YapeWin32.exe
STAGE_DIR=/mnt/d/tmp/parobek

# Host ROM images (same files as tests/vice/roms.env).
HOST_KERNAL_STOCK=/home/maciej/Maciejdev/plus4/c16-internalfunctionrom/kicad-c16multirom/rom/sources/zimmers/kernal.318004-05.bin
HOST_BASIC_STOCK=/home/maciej/Maciejdev/plus4/c16-internalfunctionrom/kicad-c16multirom/rom/sources/zimmers/basic.318006-01.bin
HOST_KERNAL_JD=/home/maciej/Maciejdev/plus4/c16-internalfunctionrom/kicad-c16multirom/rom/sources/jiffydos/JiffyDOS_Plus4_6.01_PAL.bin

# Drive ROM images.
DRIVE_1541_STOCK=/home/maciej/Maciejdev/plus4/burstcart/jiffydos/dos1541ii-251968-03.bin
DRIVE_1541_JD=/home/maciej/Maciejdev/plus4/burstcart/jiffydos/JiffyDOS_1541-II.bin
DRIVE_1581_STOCK=/home/maciej/Maciejdev/plus4/burstcart/jiffydos/1581-rom.318045-02.bin
DRIVE_1581_JD=/home/maciej/Maciejdev/plus4/burstcart/jiffydos/JiffyDOS_1581.bin
DRIVE_1551_STOCK=/usr/local/share/vice/DRIVES/dos1551-318008-01.bin

# Parobek build used for smoke tests (via = PPI/PIO/VIA burst build).
PAROBEK_PREFIX=parobek-via
# YaPe cartridge bank: C1 or C2 (16 KB LOW + 16 KB HIGH halves of the 32 KB image).
PAROBEK_SLOT=C1

# Disk / tape images (shared with tests/vice/).
DISK_IMAGE="$(git rev-parse --show-toplevel)/tests/vice/smoke-test.d64"
DISK_IMAGE_1581="$(git rev-parse --show-toplevel)/tests/vice/smoke-test.d81"
EMPTY_TAP="$(git rev-parse --show-toplevel)/tests/vice/empty.tap"
